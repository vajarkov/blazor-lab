
@page "/tasks"
@using Microsoft.EntityFrameworkCore
@using TasksServer.Data
@inject IDbContextFactory<TasksDbContext> DbFactory

<PageTitle>Список задач</PageTitle>

<h1 class="mb-4">Список задач</h1>

<div class="card mb-4">
    <div class="card-body">
        <form @onsubmit="AddTask" @onsubmit:preventDefault>
            <div class="d-flex gap-2">
                <input class="form-control"
                       placeholder="Введите новую задачу..."
                       @bind="newTaskTitle" />

                <button class="btn btn-primary"
                        type="submit">
                    Добавить
                </button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span>Всего задач: @tasks.Count</span>
    <span>Выполнено: @tasks.Count(t => t.IsCompleted)</span>
</div>

@if (tasks.Count == 0)
{
    <div class="alert alert-info">
        Пока задач нет. Добавь первую!
    </div>
}
else
{
    <ul class="list-group">
        @foreach (var task in tasks)
        {
            <li @key="task.Id"
                class="list-group-item d-flex align-items-center gap-3">

                <input type="checkbox"
                       class="form-check-input"
                       checked="@task.IsCompleted"
                       @onchange="() => ToggleTask(task)" />

                <span class="flex-grow-1 @(task.IsCompleted ? "text-decoration-line-through text-secondary" : "")">
                    @task.Title
                </span>

                <button class="btn btn-outline-danger btn-sm"
                        @onclick="() => DeleteTask(task)">
                    Удалить
                </button>
            </li>
        }
    </ul>
}

@code {
    private List<TaskItem> tasks = [];
    private string newTaskTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        tasks = await db.Tasks
            .OrderBy(t => t.Id)
            .ToListAsync();
    }

    private async Task AddTask()
    {
        var title = newTaskTitle.Trim();

        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var task = new TaskItem
        {
            Title = title
        };

        db.Tasks.Add(task);
        await db.SaveChangesAsync();

        tasks.Add(task);
        newTaskTitle = string.Empty;
    }

    private async Task ToggleTask(TaskItem task)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var taskFromDb = await db.Tasks.FindAsync(task.Id);

        if (taskFromDb is null)
        {
            return;
        }

        taskFromDb.IsCompleted = !taskFromDb.IsCompleted;
        await db.SaveChangesAsync();

        task.IsCompleted = taskFromDb.IsCompleted;
    }

    private async Task DeleteTask(TaskItem task)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var taskFromDb = await db.Tasks.FindAsync(task.Id);

        if (taskFromDb is not null)
        {
            db.Tasks.Remove(taskFromDb);
            await db.SaveChangesAsync();
        }

        tasks.Remove(task);
    }
}
