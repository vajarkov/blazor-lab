
@page "/tasks"
@using TasksServer.Data
@using TasksServer.Services
@inject TaskService TaskService

<PageTitle>Список задач</PageTitle>
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
<h1 class="mb-4">Список задач</h1>

<div class="card mb-4">
    <div class="card-body">
        <form @onsubmit="AddTask" @onsubmit:preventDefault>
            <div class="d-flex gap-2">
                <input class="form-control"
                       placeholder="Введите новую задачу..."
                       @bind="newTaskTitle" />

                <button class="btn btn-primary"
                    type="submit"
                    disabled="@isAdding">
                    @(isAdding ? "Добавление..." : "Добавить")
                </button>
            </div>
        </form>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <span>Всего задач: @tasks.Count</span>
    <span>Выполнено: @tasks.Count(t => t.IsCompleted)</span>
</div>

@if (tasks.Count == 0)
{
    <div class="alert alert-info">
        Пока задач нет. Добавь первую!
    </div>
}
else
{
    <ul class="list-group">
        @foreach (var task in tasks)
        {
            <li @key="task.Id"
                class="list-group-item d-flex align-items-center gap-3">

                <input type="checkbox"
                       class="form-check-input"
                       checked="@task.IsCompleted"
                       @onchange="() => ToggleTask(task)" />

                <span class="flex-grow-1 @(task.IsCompleted ? "text-decoration-line-through text-secondary" : "")">
                    @task.Title
                </span>

                <button class="btn btn-outline-danger btn-sm"
                        @onclick="() => DeleteTask(task)">
                    Удалить
                </button>
            </li>
        }
    </ul>
}

@code {
    private List<TaskItem> tasks = [];
    private string newTaskTitle = string.Empty;
    private bool isAdding;
    private string? errorMessage;
    protected override async Task OnInitializedAsync()
    {
        tasks = await TaskService.GetAllAsync();
    }
/*
    private async Task AddTask()
    {
        var title = newTaskTitle.Trim();

        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        var task = await TaskService.AddAsync(title);

        tasks.Add(task);
        newTaskTitle = string.Empty;
    }
*/

    private async Task AddTask()
    {
        if (isAdding)
        {
            return;
        }

        var title = newTaskTitle.Trim();

        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        isAdding = true;

        try
        {
            var task = await TaskService.AddAsync(title);

            tasks.Add(task);
            newTaskTitle = string.Empty;
            errorMessage = null;
        }
        catch (Exception)
        {
            errorMessage = "Не удалось сохранить задачу. Попробуйте ещё раз.";
        }
        finally
        {
            isAdding = false;
        }
    }
    private async Task ToggleTask(TaskItem task)
    {
        var isCompleted = await TaskService.ToggleAsync(task.Id);

        task.IsCompleted = isCompleted;
    }

    private async Task DeleteTask(TaskItem task)
    {
        await TaskService.DeleteAsync(task.Id);

        tasks.Remove(task);
    }
}
